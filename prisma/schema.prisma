// Schema Prisma — K_Sweet (GEM V3 — Todos los 9 módulos)
// RN-001: precios en centavos/enteros; RN-007: estados de pedido; RN-008: pagos

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./ksweet.db"
}

// ─── Autenticación ───────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | STAFF
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ─── Módulo 3: Ingredientes e Insumos ────────────────────────────────────────

model Supplier {
  id           String        @id @default(cuid())
  code         String?       @unique
  name         String
  phone        String?
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ingredients  Ingredient[]
  priceSources PriceSource[]

  @@map("suppliers")
}

model ProductCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_categories")
}

model MeasureUnit {
  id        String   @id @default(cuid())
  code      String   @unique
  symbol    String   @unique
  name      String
  unitType  String   @default("MASS") // MASS | VOLUME | COUNT | OTHER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("measure_units")
}

model Ingredient {
  id               String          @id @default(cuid())
  code             String?         @unique
  name             String
  category         String          @default("INGREDIENT") // INGREDIENT | PACKAGING | DECORATION | UTENSIL o slug de ProductCategory
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  packagePriceCents Int            // Precio del empaque en centavos (RD$)
  packageQty       Float           // Cantidad en el empaque
  packageUnit      String          // Unidad del empaque: g, kg, ml, l, lb, oz, unidad
  baseUnit         String          // Unidad base para cálculos: g, ml, unidad
  factorId         String?
  factorRef        UnitConversionRef? @relation(fields: [factorId], references: [id], onDelete: SetNull)
  conversionFactor Float           @default(1) // Factor multiplicador hacia unidad base
  costPerBaseUnit  Float           // Calculado: packagePriceCents / 100 / (packageQty * conversionFactor)
  density          Float?          // g/ml para conversiones volumen→masa
  isActive         Boolean         @default(true)
  notes            String?
  importedFrom     String?         // Nombre de la hoja/fila del Excel de origen
  reviewFlag       Boolean         @default(false) // true = importado, requiere revisión
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  recipeIngredients     RecipeIngredient[]
  presentationMaterials PresentationMaterial[]
  sourceLinks           ProductSourceLink[]
  priceProposals        PriceUpdateProposal[]

  @@index([name])
  @@index([category])
  @@map("ingredients")
}

// ─── Módulo 4 & 5: Recetas, Subrecetas, Costos y Precios ─────────────────────

model Recipe {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  description       String?
  recipeType        String           @default("MOTHER") // MOTHER | SUBRECIPE
  yield             Float            // Rendimiento en porciones/unidades (> 0)
  yieldUnit         String           @default("unidad") // porciones, unidades, gramos, ml
  packageCostCents  Int              @default(0) // Costo de empaque del lote en centavos
  laborPercent      Float            @default(0) // % mano de obra sobre costo de ingredientes
  overheadPercent   Float            @default(0) // % gastos indirectos (gas, luz, agua)
  contingencyPercent Float           @default(0) // % contingencia para imprevistos sobre el subtotal del lote
  subtotalBeforeContingencyCents Int @default(0) // Subtotal antes de contingencia (centavos)
  batchCostExactCents Float          @default(0) // Costo exacto del lote con contingencia (precisión decimal)
  commercialRefCents Int?            // Referencia comercial del Excel (ej. recargo 40% RD$786.36)
  targetMargin      Float            @default(40) // Margen objetivo sobre venta %
  batchCostCents    Int              @default(0) // Calculado redondeado: subtotal + contingencia
  unitCostCents     Int              @default(0) // batchCost / yield
  costPerYieldUnit  Float            @default(0) // Costo por unidad de rendimiento (centavos / yieldUnit)
  suggestedPriceCents Int            @default(0) // unitCost / (1 - margin/100)
  currentPriceCents Int              @default(0) // Precio activo de venta de la receta madre (si aplica)
  status            String           @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  reviewFlag        Boolean          @default(false)
  notes             String?
  importedFrom      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ingredients            RecipeIngredient[]
  subRecipeUses          SubRecipeUse[]          @relation("ParentRecipe")
  usedInRecipes          SubRecipeUse[]          @relation("ChildRecipe")
  presentations          RecipePresentation[]
  presentationSubrecipes PresentationSubrecipe[] @relation("PresentationSubrecipeRef")
  saleItems              SaleItem[]
  priceHistory           RecipePriceHistory[]

  @@index([status])
  @@index([recipeType])
  @@map("recipes")
}

model RecipePresentation {
  id                    String                 @id @default(cuid())
  recipeId              String
  recipe                Recipe                 @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name                  String                 // ej: "Shot 2 oz", "Caja San Valentín 2 uds", "Completo 8\""
  sizeDescription       String?                // ej: "2 oz", "15 porciones", "Caja x 12"
  motherRecipeQty       Float                  // Cantidad de receta madre consumida
  motherRecipeUnit      String                 // Unidad consumida (unidad, g, ml, porcion)
  consumptionMode       String                 @default("YIELD_PER_BATCH") // YIELD_PER_BATCH | BATCH_FRACTION
  batchFraction         Float                  @default(1) // Fracción exacta del lote consumida por unidad
  presentationYield     Float                  @default(1) // Rendimiento de esta presentación por lote
  baseCostCents         Int                    @default(0) // Costo base redondeado de receta madre
  unitTotalCostExactCents Float                @default(0) // Costo total unitario exacto en centavos
  packagingCostCents    Int                    @default(0) // Costo de empaques específicos (vasos, tapas, caja, lazo)
  additionalCostCents   Int                    @default(0) // Costo de toppings o subrecetas complementarias
  totalCostCents        Int                    @default(0) // Costo total unitario de la presentación
  pricingMethod         String                 @default("MARGIN") // MARGIN (sobre venta) | MARKUP (recargo sobre costo)
  desiredMarginPercent  Float                  @default(40) // Margen o recargo deseado %
  suggestedPriceCents   Int                    @default(0) // Precio sugerido calculado
  finalPriceCents       Int                    @default(0) // Precio final de venta editable fijado en carta
  realProfitCents       Int                    @default(0) // Ganancia = finalPriceCents - totalCostCents
  realMarginPercent     Float                  @default(0) // Margen real = (finalPriceCents - totalCostCents) / finalPriceCents * 100
  isActive              Boolean                @default(true) // Desactivar sin romper histórico
  isComposite           Boolean                @default(false) // true = presentación agrupada (ej. caja 15 minis)
  parentId              String?
  parent                RecipePresentation?    @relation("VariantGroups", fields: [parentId], references: [id], onDelete: SetNull)
  groupPresentations    RecipePresentation[]   @relation("VariantGroups")
  groupQty              Float                  @default(1) // Unidades de la variante en la presentación agrupada
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  materials             PresentationMaterial[]
  subrecipes            PresentationSubrecipe[]
  saleItems             SaleItem[]

  @@index([recipeId])
  @@index([parentId])
  @@index([isActive])
  @@map("recipe_presentations")
}

model PresentationMaterial {
  id              String             @id @default(cuid())
  presentationId  String
  presentation    RecipePresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  ingredientId    String?
  ingredient      Ingredient?        @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  materialType    String             @default("PACKAGING") // PACKAGING | DECORATION
  name            String             // Vaso, Domo, Caja, Capacillo, Cinta, Etiqueta, Mensaje
  quantity        Float
  unit            String
  unitCostCents   Int
  totalCostCents  Int

  @@index([presentationId])
  @@index([ingredientId])
  @@map("presentation_materials")
}

model PresentationSubrecipe {
  id              String             @id @default(cuid())
  presentationId  String
  presentation    RecipePresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  subRecipeId     String?
  subRecipe       Recipe?            @relation("PresentationSubrecipeRef", fields: [subRecipeId], references: [id], onDelete: SetNull)
  name            String             // Topping, Crema adicional, Dulce de leche
  quantity        Float
  unit            String
  costCents       Int

  @@index([presentationId])
  @@index([subRecipeId])
  @@map("presentation_subrecipes")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Float      // Cantidad en la unidad especificada
  unit         String     // Unidad usada en la receta
  costCents    Int        // Costo calculado al momento de la receta (centavos)
  notes        String?

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model SubRecipeUse {
  id            String @id @default(cuid())
  parentId      String
  parent        Recipe @relation("ParentRecipe", fields: [parentId], references: [id], onDelete: Cascade)
  childId       String
  child         Recipe @relation("ChildRecipe", fields: [childId], references: [id], onDelete: Restrict)
  quantity      Float  // Número de lotes o porciones de la subreceta usados
  costCents     Int    // Costo calculado

  @@index([parentId])
  @@index([childId])
  @@map("sub_recipe_uses")
}

model RecipePriceHistory {
  id              String               @id @default(cuid())
  recipeId        String
  recipe          Recipe               @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  proposalId      String?
  proposal        PriceUpdateProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  batchCostCents  Int
  unitCostCents   Int
  priceCents      Int
  margin          Float
  recordedAt      DateTime             @default(now())
  reason          String?              // "ingredient_update" | "manual" | "import" | "portal_price_approval"

  @@index([recipeId])
  @@index([proposalId])
  @@map("recipe_price_history")
}

// ─── Módulo 1: Ventas y Clientes ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("customers")
}

model Sale {
  id              String     @id @default(cuid())
  saleDate        DateTime
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String?    // Para ventas sin cliente registrado
  notes           String?
  totalCents      Int        // Suma de items
  totalCostCents  Int        // Costo histórico congelado al momento de la venta
  collectedCents  Int        @default(0)
  balanceCents    Int        @default(0) // totalCents - collectedCents
  paymentMethod   String     @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA | TARJETA | PENDIENTE
  status          String     @default("ACTIVE") // ACTIVE | CANCELLED
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           SaleItem[]
  payments        Payment[]
  weeklyCloseId   String?
  weeklyClose     WeeklyClose? @relation(fields: [weeklyCloseId], references: [id], onDelete: SetNull)

  @@index([saleDate])
  @@index([status])
  @@index([weeklyCloseId])
  @@map("sales")
}

model SaleItem {
  id               String               @id @default(cuid())
  saleId           String
  sale             Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recipeId         String?
  recipe           Recipe?              @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  presentationId   String?
  presentation     RecipePresentation?  @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  productName      String               // Copiado en el momento de la venta (histórico)
  quantity         Float
  unitPriceCents   Int                  // Precio cobrado (RF-014 congelado)
  totalCents       Int                  // quantity * unitPriceCents
  unitCostCents    Int                  // Costo unitario histórico congelado (RF-014)
  totalCostCents   Int                  // quantity * unitCostCents
  notes            String?

  @@index([saleId])
  @@index([recipeId])
  @@index([presentationId])
  @@map("sale_items")
}

model Payment {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amountCents   Int
  method        String   // EFECTIVO | TRANSFERENCIA | TARJETA
  paidAt        DateTime @default(now())
  reference     String?
  notes         String?

  @@index([saleId])
  @@map("payments")
}

// ─── Módulo 2: Cuadre Semanal ────────────────────────────────────────────────

model WeeklyClose {
  id                   String   @id @default(cuid())
  weekStart            DateTime // Lunes 00:00 AST
  weekEnd              DateTime // Domingo 23:59:59 AST
  invoicedCents        Int      @default(0)
  collectedCents       Int      @default(0)
  pendingCents         Int      @default(0)
  costOfGoodsCents     Int      @default(0) // Suma de costos históricos de ventas
  operationalExpCents  Int      @default(0) // Suma de gastos operativos del período
  netResultCents       Int      @default(0) // invoiced - cogs - expenses
  cashFundCents        Int      @default(0) // Fondo inicial de efectivo
  expectedCashCents    Int      @default(0) // Fondo + cobros_efectivo - gastos_efectivo
  countedCashCents     Int      @default(0) // Efectivo físico contado
  cashDifferenceCents  Int      @default(0) // expectedCash - countedCash
  isClosed             Boolean  @default(false)
  closedAt             DateTime?
  notes                String?
  modifiedAfterClose   Boolean  @default(false) // Alerta RF-009
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  sales                Sale[]
  expenses             OperationalExpense[]

  @@unique([weekStart])
  @@map("weekly_closes")
}

// ─── Módulo 6: Gastos Operativos ─────────────────────────────────────────────

model ExpenseCategory {
  id       String               @id @default(cuid())
  name     String               @unique
  isActive Boolean              @default(true)
  expenses OperationalExpense[]

  @@map("expense_categories")
}

model OperationalExpense {
  id              String          @id @default(cuid())
  expenseDate     DateTime
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  concept         String
  baseAmountCents Int?
  percentage      Float?
  amountCents     Int
  paymentMethod   String          @default("EFECTIVO")
  weeklyCloseId   String?
  weeklyClose     WeeklyClose?    @relation(fields: [weeklyCloseId], references: [id], onDelete: SetNull)
  notes           String?
  isIngredientPurchase Boolean    @default(false) // Señala si ya está en costo de recetas (RF-020)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([expenseDate])
  @@index([weeklyCloseId])
  @@map("operational_expenses")
}

// ─── Módulo 7: Conversiones y Equivalencias ──────────────────────────────────

model UnitConversionRef {
  id          String       @id @default(cuid())
  code        String?      @unique
  name        String       @unique // "taza_harina", "cucharada_azucar"
  category    String       @default("GENERAL") // MASS | VOLUME | COUNT | INGREDIENT | GENERAL
  fromUnit    String
  toUnit      String
  factor      Float        // toUnit = fromUnit * factor
  ingredient  String?      // Si aplica sólo a un ingrediente
  isEditable  Boolean      @default(true)
  isActive    Boolean      @default(true)
  source      String       @default("EXCEL") // "EXCEL" | "STANDARD" | "USER"
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ingredients Ingredient[]

  @@map("unit_conversion_refs")
}

// ─── Módulo 8: Importación XLSX / Trazabilidad ───────────────────────────────

model ImportSession {
  id          String       @id @default(cuid())
  fileName    String
  fileSizeKb  Float
  sheetCount  Int
  status      String       @default("PENDING") // PENDING | PREVIEWING | CONFIRMED | CANCELLED
  mappingJson String?      // JSON con el mapeo de columnas
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rows        ImportRow[]

  @@map("import_sessions")
}

model ImportRow {
  id              String        @id @default(cuid())
  sessionId       String
  session         ImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sheetName       String
  rowIndex        Int
  rawDataJson     String        // Datos crudos del Excel preservados
  mappedDataJson  String?       // Datos mapeados
  status          String        @default("DRAFT") // DRAFT | IMPORTED | SKIPPED | ERROR
  errorMessage    String?
  isDuplicate     Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([sessionId])
  @@map("import_rows")
}


// ─── Módulo 9: Actualización de Precios desde Portales RD ────────────────────

model PriceSource {
  id                     String                @id @default(cuid())
  code                   String                @unique
  name                   String
  baseUrl                String?
  supplierId             String?
  supplier               Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  adapterType            String                // VTEX_IO | SHOPIFY_JSON | WOOCOMMERCE_HTML | GENERIC_HTML | MANUAL_ASSISTED
  captureMode            String                @default("AUTO") // AUTO | ASSISTED | MANUAL
  taxMode                String                @default("INCLUDED") // INCLUDED | PLUS_ITBIS
  currency               String                @default("DOP")
  rateLimitMs            Int                   @default(2000)
  timeoutMs              Int                   @default(10000)
  proposalTtlHours       Int                   @default(168) // 7 días
  priceAlertThresholdPct Float                 @default(20)
  configJson             String?
  isActive               Boolean               @default(true)
  lastSyncedAt           DateTime?
  lastStatus             String?               // OK | DEGRADED | BLOCKED | ERROR
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  links                  ProductSourceLink[]
  syncRuns               PriceSyncRun[]
  proposals              PriceUpdateProposal[]

  @@index([isActive])
  @@index([supplierId])
  @@map("price_sources")
}

model ProductSourceLink {
  id                       String                @id @default(cuid())
  ingredientId             String
  ingredient               Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  sourceId                 String
  source                   PriceSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  isPrimary                Boolean               @default(false)
  externalSku              String?
  externalUrl              String?
  externalName             String?
  expectedPackageQty       Float
  expectedPackageUnit      String
  expectedConversionFactor Float                 @default(1)
  expectedBaseQty          Float
  packTolerancePct         Float                 @default(5)
  applyStrategy            String                @default("STRICT_SAME_PACK") // STRICT_SAME_PACK | REBASE_UNIT_COST | ADOPT_SOURCE_PACK
  taxRatePct               Float                 @default(0) // 0 | 16 | 18 (ITBIS RD Ley 253-12)
  lastCheckedAt            DateTime?
  lastSeenPriceCents       Int?
  lastSeenInStock          Boolean?
  lastError                String?
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  proposals                PriceUpdateProposal[]

  @@index([ingredientId])
  @@index([sourceId])
  @@index([isActive])
  @@map("product_source_links")
}

model PriceSyncRun {
  id               String                @id @default(cuid())
  sourceId         String?
  source           PriceSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  triggerType      String                // MANUAL_ALL | MANUAL_SOURCE | MANUAL_RECIPE | ASSISTED_TEXT | ASSISTED_CSV | ASSISTED_INVOICE
  status           String                @default("RUNNING") // RUNNING | OK | DEGRADED | BLOCKED | ERROR
  totalChecked     Int                   @default(0)
  proposalsCreated Int                   @default(0)
  errorsCount      Int                   @default(0)
  summaryJson      String?
  startedAt        DateTime              @default(now())
  finishedAt       DateTime?
  proposals        PriceUpdateProposal[]

  @@index([sourceId, startedAt])
  @@index([status])
  @@map("price_sync_runs")
}

model PriceUpdateProposal {
  id                         String               @id @default(cuid())
  code                       String               @unique // PRP-001
  runId                      String?
  run                        PriceSyncRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  linkId                     String?
  link                       ProductSourceLink?   @relation(fields: [linkId], references: [id], onDelete: SetNull)
  ingredientId               String
  ingredient                 Ingredient           @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  sourceId                   String
  source                     PriceSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status                     String               @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  applyStrategyUsed          String               @default("STRICT_SAME_PACK")
  currentPriceCents          Int
  currentCostPerBaseUnit     Float
  currentIngredientUpdatedAt DateTime
  detectedPriceCents         Int
  detectedInStock            Boolean              @default(true)
  detectedPackQty            Float?
  detectedPackUnit           String?
  detectedRawTitle           String?
  proposedPriceCents         Int
  proposedCostPerBaseUnit    Float
  proposedPackageQty         Float?
  proposedPackageUnit        String?
  proposedConversionFactor   Float?
  diffPriceCents             Int
  diffPercent                Float
  packCheckStatus            String               @default("UNKNOWN") // MATCH | UNIT_CONVERTED | PACK_MISMATCH | UNIT_INCOMPATIBLE | UNKNOWN
  alertsJson                 String?
  evidenceUrl                String?
  reviewNote                 String?
  reviewedAt                 DateTime?
  expiresAt                  DateTime
  appliedSnapshotJson        String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  priceHistoryEntries        RecipePriceHistory[]

  @@index([status, expiresAt])
  @@index([ingredientId, status])
  @@index([runId])
  @@index([linkId])
  @@map("price_update_proposals")
}
